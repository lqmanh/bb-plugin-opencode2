{
  "name": "bb-plugin-opencode2",
  "version": "1.4.0",
  "description": "BB plugin that runs threads through an installed OpenCode v2 server.",
  "keywords": [
    "bb-plugin",
    "opencode",
    "provider"
  ],
  "homepage": "https://github.com/lqmanh/bb-plugin-opencode2#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lqmanh/bb-plugin-opencode2.git"
  },
  "bugs": {
    "url": "https://github.com/lqmanh/bb-plugin-opencode2/issues"
  },
  "author": {
    "name": "Evan",
    "url": "https://github.com/iamEvanYT"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "bb": ">=0.48.1",
    "bbPluginSdk": ">=0.6.104"
  },
  "scripts": {
    "build": "bb plugin build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 \"tests/**/*.test.ts\" && vitest run tests/app/app.test.tsx",
    "check": "npm run format:check && npm run typecheck && npm test"
  },
  "bb": {
    "name": "OpenCode v2",
    "description": "Run BB threads through an installed OpenCode v2 server.",
    "branding": {
      "icon": "./icons/opencode.svg"
    },
    "server": "./src/server/index.ts",
    "host": "./src/host/index.ts",
    "app": "./src/app/index.tsx"
  },
  "dependencies": {
    "@opencode/client": "2.2.5",
    "@radix-ui/react-slot": "^1.5.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.104",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.10.2",
    "hono": "^4.13.14",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "tailwind-merge": "^3.4.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
